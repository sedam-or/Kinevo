# Kinevo — repository-level ignores

# Bootstrap helper state
.bootstrap-state/
.aider*

# Secrets — never commit
**/.env
**/.env.*
!**/.env.example
*.key
*.pem
*.crt

# Editor / IDE
.idea/
.vscode/
*.swp
*.swo

# OS junk
.DS_Store
Thumbs.db

# Logs / temp
*.log
*.tmp

# PHP / Composer artifacts
server/vendor/
server/.phpunit.result.cache
server/.phpunit.cache/

# Node
/node_modules/
server/node_modules/
server/public/build/

# Third-party agent skills (installed locally, not vendored in git)
.agents/skills/
.claude/
skills-lock.json
ui-ux-pro-max-skill/
storage/backups/*.sql.gz
