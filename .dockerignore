# Keep dev/build artifacts and local caches out of the image build context.
# The production image regenerates its own vendor, bootstrap caches, and
# frontend build (Dockerfile.prod).

# Local runtime/build state
**/node_modules
**/vendor
**/bootstrap/cache/*
!**/bootstrap/cache/.gitignore
**/storage/logs/*
**/storage/framework/cache/*
**/storage/framework/sessions/*
**/storage/framework/views/*
# User uploads / runtime storage must never enter the image (and can be
# root-owned at build time, which breaks the build-context walk).
**/storage/app/*
!**/storage/app/.gitignore
**/.env
**/.env.*
!**/.env.production.example
**/.git

# Local tooling / editor artifacts
**/.idea
**/.vscode
**/*.log
**/coverage
**/.phpunit.result.cache
**/.phpunit.cache
