# Kinevo — environment template
# Copy to .env and set secrets per environment. See docs/environment.md.
# Secrets are marked [SECRET] — never commit real values.

# --- Application ------------------------------------------------------------
APP_NAME="Kinevo"
APP_ENV=local
# [SECRET] generate with: php artisan key:generate
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

# --- Logging ----------------------------------------------------------------
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# --- Database ---------------------------------------------------------------
# PostgreSQL is the canonical structured store (docs/architecture.md).
# sqlite may be used for local tests only (see phpunit.xml).
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=kinevo
DB_USERNAME=kinevo
# [SECRET]
DB_PASSWORD=change-me
DB_SSLMODE=prefer

# --- Session / broadcast ----------------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# Sanctum API token auth (NFR-02). Set to the web frontend origin when SPA auth is used.
SANCTUM_STATEFUL_DOMAINS=localhost:8000

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

# --- Cache / queue ----------------------------------------------------------
CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

# Redis is optional; database driver is the default.
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
# [SECRET]
REDIS_PASSWORD=null
REDIS_PORT=6379

# --- Mail -------------------------------------------------------------------
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
# [SECRET]
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# --- Object storage ---------------------------------------------------------
# [SECRET]
AWS_ACCESS_KEY_ID=
# [SECRET]
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# --- Vite -------------------------------------------------------------------
VITE_APP_NAME="${APP_NAME}"

# --- AI (optional; docs/ai-architecture.md) ---------------------------------
# Provider drivers: ollama | openai | mock | disabled
# The app MUST remain operational when the provider is unavailable (SRS FR-60).
AI_PROVIDER=disabled
AI_TIMEOUT_SECONDS=30
# Local Ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1
# External OpenAI-compatible provider (opt-in) — [SECRET] key
OPENAI_BASE_URL=https://api.openai.com/v1
# [SECRET]
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Mock provider (deterministic, for local development/testing)
AI_MOCK_MODEL=mock-1
# Request budgets (SRS §13.4 minimal context)
AI_MAX_PROMPT_CHARS=8000
AI_MAX_SYSTEM_PROMPT_CHARS=2000
# Cost alerts (TASK-P25-010) — leave empty to disable a check
# AI_OPS_DAILY_COST_LIMIT=
# AI_ANOMALY_DAILY_REQUESTS=