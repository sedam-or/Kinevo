{
  "name": "@nivaras/web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": "26.13.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "tokens": "node scripts/build-tokens.ts && biome format --write --css-parse-tailwind-directives=true src/styles/tokens.css src/styles/tokens.d.ts",
    "check:i18n": "node scripts/check-i18n.ts",
    "lint": "pnpm tokens && pnpm check:i18n && biome check --css-parse-tailwind-directives=true . && git diff --exit-code -- src/styles/tokens.css src/styles/tokens.d.ts",
    "test": "vitest run",
    "gen:api": "openapi-typescript ../contracts/openapi.json -o src/api/schema.d.ts"
  },
  "dependencies": {
    "@tanstack/react-query": "5.105.0",
    "@tanstack/react-router": "1.170.46",
    "i18next": "26.5.10",
    "i18next-icu": "2.6.1",
    "intl-messageformat": "12.1.4",
    "openapi-fetch": "0.17.0",
    "react": "19.3.1",
    "react-aria-components": "1.22.1",
    "react-dom": "19.3.1",
    "react-hook-form": "7.91.0",
    "react-i18next": "17.1.8",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@biomejs/biome": "2.6.4",
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/culori": "4.0.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "culori": "4.0.2",
    "jsdom": "30.1.3",
    "msw": "3.0.3",
    "openapi-typescript": "7.13.0",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
